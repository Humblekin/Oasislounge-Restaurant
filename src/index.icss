  background: var(--primary);
  border: none;
  color: white;
  font-weight: 700;
  font-size: 0.85rem;
  cursor: pointer;
  padding: 0.5rem 1.25rem;
  border-radius: 2rem;
  transition: var(--transition);
  margin-left: 0.5rem;
}
  background: var(--primary- hover);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(249, 115, 22, 0.3);
}
/* Auth Page Toggle Button */
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap");

/* ===== COMPREHENSIVE RESPONSIVE DESIGN SYSTEM ===== */
/* Mobile-First Approach: 0-640px | Tablet: 641-1024px | Desktop: 1025px+ */

:root {
  --bg-deep: #f8fafc;
  --bg-main: #ffffff;
  --surface: #ffffff;
  --surface-hover: #f1f5f9;
  --primary: #f97316;
  --primary-hover: #ea580c;
  --primary-light: #fff7ed;
  --text-main: #0f172a;
  --text-muted: #64748b;
  --accent-blue: #0ea5e9;
  --accent-pink: #f43f5e;
  --border: rgba(0, 0, 0, 0.05);

  --radius-sm: 0.75rem;
  --radius-lg: 1.5rem;
  --radius-xl: 3rem;
  --transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  --glass: backdrop-filter: blur(24px) saturate(180%);
  --shadow-premium: 0 20px 50px -12px rgba(0, 0, 0, 0.1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
}
body {
  font-family: "Inter", sans-serif;
  background: var(--bg-main);
  color: var(--text-main);
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: #fff;
}
::-webkit-scrollbar-thumb {
  background: #e2e8f0;
  border-radius: 10px;
}
::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* ===== LAYOUT ===== */
.container {
  width: 100%;
  margin: 0 auto;
  padding: 0 1rem;
}
@media (min-width: 641px) {
  .container {
    padding: 0 1.5rem;
    max-width: 640px;
  }
}
@media (min-width: 1025px) {
  .container {
    max-width: 1280px;
    padding: 0 2rem;
  }
}

.flex {
  display: flex;
}
.flex-col {
  flex-direction: column;
}
.items-start {
  align-items: flex-start;
}
.items-center {
  align-items: center;
}
.items-end {
  align-items: flex-end;
}
.justify-start {
  justify-content: flex-start;
}
.justify-center {
  justify-content: center;
}
.justify-between {
  justify-content: space-between;
}
.justify-end {
  justify-content: flex-end;
}

.gap-2 {
  gap: 0.5rem;
}
.gap-3 {
  gap: 0.75rem;
}
.gap-4 {
  gap: 1rem;
}
.gap-6 {
  gap: 1.5rem;
}
.gap-8 {
  gap: 2rem;
}
@media (max-width: 640px) {
  .gap-4 {
    gap: 0.75rem;
  }
  .gap-6 {
    gap: 1rem;
  }
  .gap-8 {
    gap: 1.5rem;
  }
}

.m-0 {
  margin: 0;
}
.m-auto {
  margin: auto;
}
.mt-1 {
  margin-top: 0.25rem;
}
.mt-2 {
  margin-top: 0.5rem;
}
.mt-3 {
  margin-top: 0.75rem;
}
.mt-4 {
  margin-top: 1rem;
}
.mt-6 {
  margin-top: 1.5rem;
}
.mt-8 {
  margin-top: 2rem;
}
.mt-12 {
  margin-top: 3rem;
}
.mb-1 {
  margin-bottom: 0.25rem;
}
.mb-2 {
  margin-bottom: 0.5rem;
}
.mb-3 {
  margin-bottom: 0.75rem;
}
.mb-4 {
  margin-bottom: 1rem;
}
.mb-6 {
  margin-bottom: 1.5rem;
}
.mb-8 {
  margin-bottom: 2rem;
}
.mb-12 {
  margin-bottom: 3rem;
}
.mx-auto {
  margin-left: auto;
  margin-right: auto;
}
@media (max-width: 640px) {
  .mt-6 {
    margin-top: 1rem;
  }
  .mt-8 {
    margin-top: 1.5rem;
  }
  .mt-12 {
    margin-top: 2rem;
  }
  .mb-6 {
    margin-bottom: 1rem;
  }
  .mb-8 {
    margin-bottom: 1.5rem;
  }
  .mb-12 {
    margin-bottom: 2rem;
  }
}

.p-2 {
  padding: 0.5rem;
}
.p-3 {
  padding: 0.75rem;
}
.p-4 {
  padding: 1rem;
}
.px-2 {
  padding: 0 0.5rem;
}
.px-3 {
  padding: 0 0.75rem;
}
.px-4 {
  padding: 0 1rem;
}
.py-2 {
  padding: 0.5rem 0;
}
.py-3 {
  padding: 0.75rem 0;
}
.py-4 {
  padding: 1rem 0;
}
.py-6 {
  padding: 1.5rem 0;
}
.py-8 {
  padding: 2rem 0;
}
.py-12 {
  padding: 3rem 0;
}
.py-16 {
  padding: 4rem 0;
}
@media (max-width: 640px) {
  .py-8 {
    padding: 1.5rem 0;
  }
  .py-12 {
    padding: 2rem 0;
  }
  .py-16 {
    padding: 2.5rem 0;
  }
}

.w-full {
  width: 100%;
}
.w-auto {
  width: auto;
}
.h-auto {
  height: auto;
}
.w-12 {
  width: 3rem;
}
.h-12 {
  height: 3rem;
}

.text-left {
  text-align: left;
}
.text-center {
  text-align: center;
}
.text-right {
  text-align: right;
}
.text-sm {
  font-size: 0.875rem;
}
.text-base {
  font-size: 1rem;
}
.text-lg {
  font-size: 1.125rem;
}
.text-xl {
  font-size: 1.25rem;
}
.font-medium {
  font-weight: 500;
}
.font-semibold {
  font-weight: 600;
}
.font-bold {
  font-weight: 700;
}
.font-black {
  font-weight: 900;
}

.hidden {
  display: none !important;
}
.md\:flex {
  display: none;
}
.md\:hidden {
  display: none;
}
.mobile\:flex {
  display: flex;
}
@media (min-width: 641px) {
  .md\:flex {
    display: flex;
  }
  .md\:hidden {
    display: none !important;
  }
  .mobile\:flex {
    display: none;
  }
}

/* ===== TYPOGRAPHY & LOGO ===== */
.logo {
  font-size: 1.1rem;
  font-weight: 900;
  letter-spacing: -0.5px;
  color: var(--text-main);
  white-space: nowrap;
}
@media (min-width: 641px) {
  .logo {
    font-size: 1.3rem;
  }
}
@media (min-width: 1025px) {
  .logo {
    font-size: 1.5rem;
  }
}
.logo span {
  color: var(--primary);
}

/* ===== HEADER/NAV ===== */
.header {
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 100;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 0.75rem 0;
}
@media (min-width: 641px) {
  .header {
    padding: 1rem 0;
  }
}

.nav-search-container {
  position: relative;
  display: none;
  align-items: center;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  margin-left: 2rem;
}
@media (min-width: 641px) {
  .nav-search-container {
    display: flex;
  }
}

.nav-search-input {
  background: #f8fafc;
  border: 1px solid #f1f5f9;
  color: #0f172a;
  padding: 0.5rem 1rem 0.5rem 2.5rem;
  border-radius: 100px;
  font-family: inherit;
  font-size: 0.85rem;
  font-weight: 600;
  width: 150px;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  outline: none;
}
@media (min-width: 1025px) {
  .nav-search-input {
    width: 280px;
  }
  .nav-search-input:focus {
    width: 360px;
    background: white;
    border-color: var(--primary);
    box-shadow:
      0 10px 25px -5px rgba(249, 115, 22, 0.1),
      0 0 0 4px rgba(249, 115, 22, 0.05);
  }
}

.nav-search-icon {
  position: absolute;
  left: 1.25rem;
  color: #94a3b8;
  transition: all 0.3s ease;
  pointer-events: none;
  width: 16px;
  height: 16px;
}
.nav-search-container:focus-within .nav-search-icon {
  color: var(--primary);
  transform: scale(1.1);
}

/* ===== BUTTONS ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.65rem 1.25rem;
  border-radius: 1rem;
  font-weight: 600;
  font-size: 0.85rem;
  cursor: pointer;
  border: none;
  transition: var(--transition);
  text-decoration: none;
  white-space: nowrap;
}
@media (min-width: 641px) {
  .btn {
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
  }
}
@media (min-width: 1025px) {
  .btn {
    padding: 0.8rem 1.8rem;
    font-size: 1rem;
  }
}

.btn-primary {
  background: var(--primary);
  color: var(--bg-deep);
  box-shadow: 0 8px 20px rgba(249, 115, 22, 0.2);
}
.btn-primary:hover {
  background: var(--primary-hover);
  transform: scale(1.02);
}
.btn-primary:active {
  transform: scale(0.98);
}

.btn-surface {
  background: #fff;
  color: var(--text-main);
  border: 1px solid var(--border);
  font-size: 0.8rem;
}
@media (min-width: 641px) {
  .btn-surface {
    font-size: 0.9rem;
  }
}
.btn-surface:hover {
  background: var(--surface-hover);
  border-color: var(--primary);
}

.btn-lg {
  padding: 0.8rem 1.5rem;
  font-size: 0.9rem;
  width: 100%;
}
@media (min-width: 641px) {
  .btn-lg {
    padding: 1rem 2rem;
    font-size: 1rem;
    width: auto;
  }
}

.btn-logout {
  padding: 0.4rem 0.8rem;
  font-size: 0.65rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #f43f5e;
  background: #fff1f2;
  border: 1px solid #ffe4e6;
  border-radius: 0.75rem;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
@media (min-width: 641px) {
  .btn-logout {
    padding: 0.5rem 1rem;
    font-size: 0.7rem;
  }
}
.btn-logout:hover {
  background: #f43f5e;
  color: #fff;
  border-color: #f43f5e;
  box-shadow: 0 4px 12px rgba(244, 63, 94, 0.2);
  transform: translateY(-1px);
}
.btn-logout:active {
  transform: translateY(0);
}

/* ===== INPUTS & FORMS ===== */
.input {
  background: #fff;
  border: 1px solid #e2e8f0;
  color: var(--text-main);
  padding: 0.65rem 1rem;
  border-radius: 1rem;
  font-family: inherit;
  font-size: 0.95rem;
  transition: var(--transition);
  width: 100%;
}
@media (min-width: 641px) {
  .input {
    padding: 0.75rem 1.2rem;
    font-size: 1rem;
  }
}
.input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 4px var(--primary-light);
}

.input-group {
  position: relative;
  display: flex;
  align-items: center;
}
.input-icon {
  position: absolute;
  left: 1rem;
  color: #94a3b8;
  pointer-events: none;
  width: 18px;
  height: 18px;
}
.input-group .input {
  padding-left: 2.75rem;
}

/* ===== CARDS & CONTAINERS ===== */
.premium-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1rem;
  transition: var(--transition);
  box-shadow:
    0 4px 6px -1px rgba(0, 0, 0, 0.05),
    0 2px 4px -2px rgba(0, 0, 0, 0.05);
}
@media (min-width: 641px) {
  .premium-card {
    padding: 1.25rem;
  }
}
@media (min-width: 1025px) {
  .premium-card {
    padding: 1.5rem;
  }
}
.premium-card:hover {
  transform: translateY(-4px);
  border-color: var(--primary);
  box-shadow:
    0 20px 25px -5px rgba(0, 0, 0, 0.1),
    0 8px 10px -6px rgba(0, 0, 0, 0.1);
}

.text-gradient {
  background: linear-gradient(90deg, var(--primary), var(--primary-hover));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.premium-glass {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.badge {
  padding: 0.2rem 0.8rem;
  border-radius: 2rem;
  font-size: 0.65rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* ===== ANIMATIONS ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes badgePop {
  0% {
    transform: scale(0);
  }
  80% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}
@keyframes vibrate {
  0%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-2px);
  }
  75% {
    transform: translateX(2px);
  }
}
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.fade-in {
  animation: fadeInUp 0.6s ease-out forwards;
}
.vibrate {
  animation: vibrate 0.3s ease-in-out;
}
.spinner-pro {
  display: inline-block;
  width: 40px;
  height: 40px;
  border: 4px solid rgba(249, 115, 22, 0.1);
  border-top: 4px solid var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* ===== MENU & GRID ===== */
.menu-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  padding: 1.5rem 0;
}
@media (min-width: 641px) {
  .menu-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    padding: 2rem 0;
  }
}
@media (min-width: 1025px) {
  .menu-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
}

.gourmet-card {
  background: white;
  border-radius: var(--radius-xl);
  overflow: hidden;
  transition: var(--transition);
  border: 1px solid rgba(0, 0, 0, 0.04);
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
}
.gourmet-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 30px 60px -10px rgba(0, 0, 0, 0.1);
  border-color: rgba(249, 115, 22, 0.2);
}
@media (min-width: 1025px) {
  .gourmet-card:hover {
    transform: translateY(-15px);
    box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.12);
  }
}

.card-image-wrapper {
  position: relative;
  height: 180px;
  overflow: hidden;
  margin: 0.75rem;
  border-radius: calc(var(--radius-xl) - 0.75rem);
  background: #f8fafc;
}
@media (min-width: 641px) {
  .card-image-wrapper {
    height: 200px;
    margin: 1rem;
  }
}
@media (min-width: 1025px) {
  .card-image-wrapper {
    height: 260px;
  }
}

.card-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.gourmet-card:hover .card-image-wrapper img {
  transform: scale(1.1) rotate(1deg);
}

.price-tag {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  padding: 0.5rem 1rem;
  border-radius: 1.25rem;
  font-weight: 900;
  font-size: 0.85rem;
  color: #0f172a;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  z-index: 10;
  letter-spacing: -0.02em;
}
@media (min-width: 641px) {
  .price-tag {
    font-size: 0.95rem;
    padding: 0.6rem 1.2rem;
  }
}

.card-content {
  padding: 0.75rem 1.25rem 1.25rem;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
}
@media (min-width: 641px) {
  .card-content {
    padding: 1rem 1.5rem 1.5rem;
  }
}
@media (min-width: 1025px) {
  .card-content {
    padding: 0.5rem 2rem 2rem;
  }
}

.card-category {
  font-size: 0.65rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--primary);
  margin-bottom: 0.5rem;
  display: block;
}
@media (min-width: 641px) {
  .card-category {
    font-size: 0.7rem;
    margin-bottom: 0.6rem;
  }
}

.card-title {
  font-size: 1.1rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
  color: #0f172a;
  letter-spacing: -0.03em;
  line-height: 1.1;
}
@media (min-width: 641px) {
  .card-title {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
  }
}
@media (min-width: 1025px) {
  .card-title {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
}

.card-description {
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin-bottom: 1rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
@media (min-width: 641px) {
  .card-description {
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }
}
@media (min-width: 1025px) {
  .card-description {
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
}

.add-btn {
  width: 100%;
  background: #0f172a;
  color: white;
  padding: 0.8rem 1rem;
  border-radius: 1.5rem;
  font-weight: 800;
  font-size: 0.75rem;
  border: none;
  cursor: pointer;
  transition: var(--transition);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  margin-top: auto;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
@media (min-width: 641px) {
  .add-btn {
    padding: 1rem 1.2rem;
    font-size: 0.8rem;
  }
}
@media (min-width: 1025px) {
  .add-btn {
    padding: 1.2rem 1.5rem;
    font-size: 0.85rem;
  }
}
.add-btn:hover {
  background: var(--primary);
  transform: scale(1.02);
  box-shadow: 0 15px 30px rgba(249, 115, 22, 0.3);
}

.category-pills {
  display: flex;
  gap: 0.75rem;
  overflow-x: auto;
  padding: 0.75rem 0 2rem;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
@media (min-width: 641px) {
  .category-pills {
    gap: 1rem;
    padding: 1rem 0 3rem;
  }
}
.category-pills::-webkit-scrollbar {
  display: none;
}

.pill {
  padding: 0.65rem 1.25rem;
  background: white;
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 100px;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--text-muted);
  white-space: nowrap;
  cursor: pointer;
  transition: var(--transition);
  flex-shrink: 0;
}
@media (min-width: 641px) {
  .pill {
    padding: 0.8rem 1.5rem;
    font-size: 0.9rem;
  }
}
@media (min-width: 1025px) {
  .pill {
    padding: 1rem 2rem;
    font-size: 0.9rem;
  }
}
.pill:hover {
  border-color: var(--primary);
  color: var(--primary);
  transform: translateY(-2px);
}
.pill.active {
  background: #0f172a;
  color: white;
  border-color: #0f172a;
  box-shadow: 0 10px 20px rgba(15, 23, 42, 0.2);
}

.gourmet-glow::after {
  content: "";
  position: absolute;
  inset: -1px;
  background: linear-gradient(
    45deg,
    var(--primary),
    transparent,
    var(--accent-blue)
  );
  opacity: 0;
  transition: var(--transition);
  z-index: -1;
  border-radius: inherit;
}
.gourmet-glow:hover::after {
  opacity: 0.15;
  inset: -5px;
}

.cart-badge-anim {
  position: absolute;
  top: -8px;
  right: -8px;
  background: var(--accent-pink);
  color: white;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  font-weight: 900;
  animation: badgePop 0.4s ease-out;
}
@media (min-width: 641px) {
  .cart-badge-anim {
    width: 28px;
    height: 28px;
    font-size: 0.75rem;
  }
}

.hide-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.hide-scrollbar::-webkit-scrollbar {
  display: none;
}

.cart-jewel {
  position: relative;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.05);
  border-radius: 50%;
  cursor: pointer;
  transition: var(--transition);
  color: var(--text-main);
}
@media (min-width: 641px) {
  .cart-jewel {
    width: 44px;
    height: 44px;
  }
}
.cart-jewel:hover {
  background: var(--primary);
  color: white;
  transform: scale(1.05);
}

/* ===== LANDING PAGE ===== */
.landing-page {
  min-height: 100vh;
  position: relative;
}

.hero {
  padding-top: 8rem;
  padding-bottom: 2rem;
}
@media (min-width: 641px) {
  .hero {
    padding-top: 10rem;
    padding-bottom: 3rem;
  }
}
@media (min-width: 1025px) {
  .hero {
    padding-top: 15vh;
    padding-bottom: 5vh;
  }
}

.hero-badge {
  display: inline-block;
  background: rgba(245, 158, 11, 0.1);
  color: var(--primary);
  margin-bottom: 0.75rem;
  border: 1px solid rgba(245, 158, 11, 0.2);
  padding: 0.4rem 1rem;
  border-radius: 2rem;
  font-size: 0.65rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
@media (min-width: 641px) {
  .hero-badge {
    margin-bottom: 1rem;
    padding: 0.5rem 1.2rem;
    font-size: 0.7rem;
  }
}

.hero-title {
  font-size: 2rem;
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 1rem;
  letter-spacing: -2px;
  text-align: center;
}
@media (min-width: 641px) {
  .hero-title {
    font-size: 3rem;
    margin-bottom: 1.25rem;
  }
}
@media (min-width: 1025px) {
  .hero-title {
    font-size: 4.5rem;
    margin-bottom: 1.5rem;
  }
}

.hero-subtext {
  font-size: 1rem;
  color: var(--text-muted);
  max-width: 600px;
  margin: 0 auto;
  text-align: center;
  line-height: 1.6;
}
@media (min-width: 641px) {
  .hero-subtext {
    font-size: 1.1rem;
  }
}
@media (min-width: 1025px) {
  .hero-subtext {
    font-size: 1.25rem;
  }
}

.hero-btns {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.75rem;
  margin-top: 1.5rem;
}
@media (min-width: 641px) {
  .hero-btns {
    flex-direction: row;
    gap: 1rem;
    margin-top: 2rem;
  }
}

.hero-image-container {
  margin-top: 2rem;
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid var(--border);
  width: 100%;
  box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.1);
}
@media (min-width: 641px) {
  .hero-image-container {
    margin-top: 3rem;
    height: 300px;
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.1);
  }
}
@media (min-width: 1025px) {
  .hero-image-container {
    margin-top: 4rem;
    height: 400px;
    aspect-ratio: 21/9;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
  }
}
.hero-image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  margin-top: 2rem;
}
@media (min-width: 641px) {
  .feature-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-top: 2.5rem;
  }
}
@media (min-width: 1025px) {
  .feature-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 4rem;
  }
}

.feature-icon {
  color: var(--primary);
  width: 2rem;
  height: 2rem;
  margin-bottom: 0.75rem;
}
@media (min-width: 641px) {
  .feature-icon {
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 1rem;
  }
}
@media (min-width: 1025px) {
  .feature-icon {
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
  }
}

.blob-1 {
  position: absolute;
  top: -10%;
  left: -10%;
  width: 60%;
  height: 60%;
  background: radial-gradient(
    circle,
    rgba(249, 115, 22, 0.08) 0%,
    transparent 70%
  );
  filter: blur(60px);
  pointer-events: none;
}
@media (min-width: 1025px) {
  .blob-1 {
    width: 50%;
    height: 50%;
  }
}

.blob-2 {
  position: absolute;
  bottom: -15%;
  right: -15%;
  width: 50%;
  height: 50%;
  background: radial-gradient(
    circle,
    rgba(249, 115, 22, 0.05) 0%,
    transparent 70%
  );
  filter: blur(60px);
  pointer-events: none;
}
@media (min-width: 1025px) {
  .blob-2 {
    bottom: -10%;
    right: -10%;
    width: 40%;
    height: 40%;
  }
}

/* ===== AUTH PAGE ===== */
.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 1rem;
}
.auth-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.auth-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.auth-bg .overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

.auth-container {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 400px;
}

.auth-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  padding: 1.5rem;
  border-radius: 2rem;
}
@media (min-width: 641px) {
  .auth-card {
    padding: 2.5rem;
  }
}

.auth-header {
  margin-bottom: 1.5rem;
}

.auth-logo {
  width: 50px;
  height: 50px;
  background: var(--primary-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  margin: 0 auto 1rem;
}

.auth-header h1 {
  font-size: 1.5rem;
  font-weight: 900;
  margin-bottom: 0.5rem;
}
@media (min-width: 641px) {
  .auth-header h1 {
    font-size: 1.75rem;
  }
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
@media (min-width: 641px) {
  .auth-form {
    gap: 1.25rem;
  }
}

.auth-alert {
  padding: 1rem;
  border-radius: 1rem;
  font-size: 0.9rem;
  margin-bottom: 1rem;
}
.auth-alert.success {
  background: #d1fae5;
  color: #065f46;
  border: 1px solid #a7f3d0;
}
.auth-alert.error {
  background: #fee2e2;
  color: #7f1d1d;
  border: 1px solid #fecaca;
}

/* ===== CHATBOT ===== */
.chat-trigger {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  width: 56px;
  height: 56px;
  background: var(--primary);
  color: white;
  border-radius: 50%;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 30px rgba(249, 115, 22, 0.3);
  transition: var(--transition);
  z-index: 50;
}
@media (max-width: 640px) {
  .chat-trigger {
    width: 50px;
    height: 50px;
    bottom: 1.5rem;
    right: 1.5rem;
  }
}
.chat-trigger:hover {
  transform: scale(1.1);
  box-shadow: 0 12px 40px rgba(249, 115, 22, 0.4);
}

.ping-dot {
  position: absolute;
  width: 12px;
  height: 12px;
  background: #f43f5e;
  border-radius: 50%;
  top: 4px;
  right: 4px;
  animation: pulse 2s infinite;
}

.chat-window {
  position: fixed;
  bottom: 8rem;
  right: 2rem;
  width: 100%;
  max-width: 400px;
  height: 500px;
  background: white;
  border-radius: 1.5rem;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  z-index: 50;
  border: 1px solid var(--border);
}
@media (max-width: 640px) {
  .chat-window {
    width: calc(100% - 2rem);
    height: 400px;
    bottom: 7rem;
    right: 1rem;
    left: 1rem;
    max-width: none;
  }
}

.chat-header {
  padding: 1rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.chat-title {
  font-weight: 700;
  font-size: 0.95rem;
  margin: 0;
}
.chat-status {
  font-size: 0.7rem;
  color: var(--text-muted);
  display: block;
}

.bot-icon {
  width: 32px;
  height: 32px;
  background: var(--primary-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
}

.close-btn {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--text-muted);
  padding: 0;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
}
.close-btn:hover {
  color: var(--text-main);
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.bubble-row {
  display: flex;
  margin-bottom: 0.75rem;
}
.bubble-row.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 80%;
  padding: 0.75rem 1rem;
  border-radius: 1rem;
  font-size: 0.9rem;
  line-height: 1.5;
  word-wrap: break-word;
}
.bubble-row.user .bubble {
  background: var(--primary);
  color: white;
  border-radius: 1rem 0.25rem 1rem 1rem;
}
.bubble-row.assistant .bubble {
  background: #f1f5f9;
  color: var(--text-main);
  border-radius: 0.25rem 1rem 1rem 1rem;
}
.bubble.typing {
  opacity: 0.7;
}

.chat-input-area {
  padding: 1rem;
  border-top: 1px solid var(--border);
  display: flex;
  gap: 0.75rem;
}
.chat-input-area input {
  flex: 1;
  padding: 0.65rem 1rem;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  font-family: inherit;
  font-size: 0.9rem;
}
.chat-input-area input:focus {
  outline: none;
  border-color: var(--primary);
}

.chat-send-btn {
  width: 36px;
  height: 36px;
  background: var(--primary);
  border: none;
  border-radius: 50%;
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
}
.chat-send-btn:hover {
  background: var(--primary-hover);
  transform: scale(1.05);
}
.chat-send-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ===== CUSTOMER APP STYLES ===== */
.spinner-pro {
  width: 48px;
  height: 48px;
  border: 4px solid #f1f5f9;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s infinite cubic-bezier(0.5, 0, 0.5, 1);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.status-pill-pro {
  padding: 6px 14px;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border-radius: 99px;
}
.status-pill-pro.pending {
  background: #fff7ed;
  color: #f97316;
  border: 1px solid #ffedd5;
}
.status-pill-pro.cooking {
  background: #f0fdf4;
  color: #16a34a;
  border: 1px solid #dcfce7;
}
.status-pill-pro.delivered {
  background: #f0f9ff;
  color: #0ea5e9;
  border: 1px solid #e0f2fe;
}

.cart-drawer-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  justify-content: flex-end;
}
.cart-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(10px);
  animation: fadeIn 0.3s ease-out;
}
.cart-drawer {
  position: relative;
  width: 100%;
  max-width: 480px;
  background: white;
  padding: 3rem;
  display: flex;
  flex-direction: column;
  box-shadow: -20px 0 60px rgba(0, 0, 0, 0.15);
  overflow-y: auto;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.vibrate {
  animation: vibrate 0.3s linear;
}
@keyframes vibrate {
  0% {
    transform: translate(0);
  }
  20% {
    transform: translate(-2px, 2px);
  }
  40% {
    transform: translate(-2px, -2px);
  }
  60% {
    transform: translate(2px, 2px);
  }
  80% {
    transform: translate(2px, -2px);
  }
  100% {
    transform: translate(0);
  }
}

.fade-right {
  animation: fadeRight 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes fadeRight {
  from {
    transform: translateX(100%);
  }
  to {
    transform: translateX(0);
  }
}

/* ===== RESPONSIVE CUSTOMER APP ===== */
@media (max-width: 640px) {
  .cart-drawer {
    padding: 2rem;
  }
  .hero-section h2 {
    font-size: 3rem;
  }
}

/* ===== AUTH PAGE STYLES ===== */
.input-group {
  position: relative;
}
.input-icon {
  position: absolute;
  left: 1.2rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
}
.input-group .input {
  padding-left: 3.5rem;
}

  background: var(--primary);
  border: none;
  color: white;
  font-weight: 700;
  font-size: 0.85rem;
  cursor: pointer;
  padding: 0.5rem 1.25rem;
  border-radius: 2rem;
  transition: var(--transition);
  margin-left: 0.5rem;
}
  background: var(--primary-dark);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(249, 115, 22, 0.3);
}

.auth-logo {
  width: 64px;
  height: 64px;
  background: var(--primary);
  color: white;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 2rem;
  box-shadow: 0 8px 16px rgba(249, 115, 22, 0.2);
}
.text-main {
  color: var(--text-main);
}

.text-muted {
  color: var(--text-muted);
}

.auth-alert {
  padding: 1rem;
  border-radius: 12px;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: 2rem;
  border-style: solid;
  border-width: 1px;
}
.auth-alert.error {
  background: rgba(244, 63, 94, 0.1);
  border-color: rgba(244, 63, 94, 0.2);
  color: var(--accent-pink);
}
.auth-alert.success {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.2);
  color: #10b981;
}

@media (max-width: 640px) {
  .auth-page {
    padding: 1rem;
  }
  .auth-card {
    padding: 2rem;
  }
}


